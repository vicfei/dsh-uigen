{
  "name": "dsh-uigen",
  "version": "0.1.0",
  "description": "Generate-and-render inline UI components for DeepSeek Harness \u2014 local-LLM component generation against a whitelisted dsh-ui catalog, schema-validated fail-closed, rendered in replies via dsh-genui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicfei/dsh-uigen.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ui",
    "components",
    "genui",
    "frontend"
  ],
  "type": "module",
  "main": "lib/compose.js",
  "exports": {
    ".": "./lib/compose.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/"
  },
  "files": [
    "lib",
    "skill",
    "docs",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}